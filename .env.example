# ============================================
# Ethereum Mainnet RPC
# ============================================

# Primary RPC endpoint
MAINNET_RPC_URL=https://eth.drpc.org

# Backup RPC endpoint #1
RPC_URL=https://eth.drpc.org

# Backup RPC endpoint #2
